# CivicLens backend — example environment configuration.
# Copy to .env for local development. NEVER commit a real .env or real secrets.
# In production, inject these via a managed secret store (see docs/security/secrets-management.md).

# --- Runtime ---
ENVIRONMENT=development

# --- Database ---
# Real PostgreSQL. psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens

# --- JWT ---
# Development placeholder ONLY. Generate a strong random value for any real deployment,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-change-me-please-0000000000000000000000000000
JWT_ALGORITHM=HS256
JWT_ISSUER=civiclens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed origins. Do NOT use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Password policy ---
PASSWORD_MIN_LENGTH=12

# --- Documents / object storage ---
# STORAGE_PROVIDER: "local" (dev/test, filesystem + HMAC-signed local URLs) or "s3".
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.document_storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_MAX_PAGES=50
SIGNED_URL_EXPIRATION_SECONDS=600
# DOCUMENT_RETENTION_DAYS: leave blank to disable automated retention cleanup.
DOCUMENT_RETENTION_DAYS=
# Document AI providers. "test" = deterministic in-repo providers (dev/tests ONLY).
# Production MUST set a real provider; selecting "test" in production fails closed.
OCR_PROVIDER=test
EXTRACTION_PROVIDER=test
MALWARE_SCANNER_PROVIDER=test
