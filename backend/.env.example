# CivicLens Backend Production-Grade Environment Configuration
# Copy to .env for local development. NEVER commit real secrets.
# Production secrets MUST be injected via AWS Secrets Manager.

# ─── ENVIRONMENT ───────────────────────────────────────────────────────────── #
ENVIRONMENT=development

# ─── DATABASE ──────────────────────────────────────────────────────────────── #
# Real PostgreSQL with psycopg v3 + pgvector extension
DATABASE_URL=postgresql+psycopg://civiclens:civiclens_dev_password@localhost:5432/civiclens

# ─── REDIS ─────────────────────────────────────────────────────────────────── #
REDIS_URL=redis://localhost:6379/0

# ─── AUTH ──────────────────────────────────────────────────────────────────── #
# Generate strong key for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-change-me-please-0000000000000000000000000000
JWT_ALGORITHM=HS256
JWT_ISSUER=civiclens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_PROVIDER=test
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── STORAGE ───────────────────────────────────────────────────────────────── #
# "local" for dev/test; "s3" for staging/production
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.document_storage
S3_BUCKET=civiclens-documents-production
S3_REGION=ap-south-1
S3_ENDPOINT=
DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_MAX_PAGES=50
SIGNED_URL_EXPIRATION_SECONDS=600

# ─── AI / RAG ──────────────────────────────────────────────────────────────── #
EMBEDDING_PROVIDER=test
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=test
LLM_MODEL=test-deterministic

# ─── OCR & DOCUMENT PROCESSING ─────────────────────────────────────────────── #
OCR_PROVIDER=test
EXTRACTION_PROVIDER=test
MALWARE_SCANNER_PROVIDER=test

# ─── NOTIFICATIONS & SUBMISSION ─────────────────────────────────────────────── #
SUBMISSION_PROVIDER=mock
EMAIL_PROVIDER=test
SMS_PROVIDER=test
PUSH_PROVIDER=test

# ─── CORS ──────────────────────────────────────────────────────────────────── #
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── SECURITY ──────────────────────────────────────────────────────────────── #
PASSWORD_MIN_LENGTH=12

# ─── OBSERVABILITY ─────────────────────────────────────────────────────────── #
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── AWS ───────────────────────────────────────────────────────────────────── #
AWS_REGION=ap-south-1
