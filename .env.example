# CivicLens Root Environment Example
# Copy to .env for docker-compose local environment

# --- Environment ---
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://civiclens:civiclens_dev_password@localhost:5432/civiclens

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=dev-only-insecure-change-me-please-0000000000000000000000000000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend Base URLs ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
